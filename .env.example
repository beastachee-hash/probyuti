# ============================================================
#  ПроБьюти · переменные окружения (пример).
#  Скопируй в .env и заполни значениями из панелей облака.
#  НЕ коммить .env в git (он уже в .gitignore).
# ============================================================

# --- Порт (Layero задаёт свой PORT автоматически, можно не трогать) ---
PORT=3000

# --- Пароль входа в кабинет администратора (обязательно смени!) ---
ADMIN_PASSWORD=probyuti2026

# ============================================================
#  ★ СПОСОБ №1 (рекомендуется, бесплатно): Яндекс.Диск
#  Достаточно одного токена — и данные, и фото уйдут на Диск.
#  Как получить токен:
#    1. https://yandex.ru/dev/disk/poligon/  (Полигон REST API)
#       или создай приложение с правом «Доступ к папке приложения на Диске»
#       на https://oauth.yandex.ru/
#    2. Получи OAuth-токен и вставь ниже.
#  Внимание: приложение с правом ТОЛЬКО «app://» использует отдельную
#  служебную папку на Диске (не мусорит в личных файлах).
# ============================================================
YDISK_TOKEN=
# Необязательно: путь папки на Диске. По умолчанию disk:/probyuti (обычная
# папка, работает с токеном Полигона). Для токена «приложения» задай: app://probyuti
YDISK_ROOT=disk:/probyuti

# --- PostgreSQL (Yandex Managed Service for PostgreSQL) — платно, способ №2 ---
# Формат: postgresql://<пользователь>:<пароль>@<хост>:6432/<база>?sslmode=require
DATABASE_URL=

# --- Yandex Object Storage (S3-совместимый) для фото — платно, способ №3 ---
YOS_ACCESS_KEY=
YOS_SECRET_KEY=
YOS_BUCKET=
YOS_REGION=ru-central1
YOS_ENDPOINT=https://storage.yandexcloud.net
